   "name": "Cap at 5 and force test address",
   "parameters": {
    "jsCode": "const MAX = 5;\nconst TEST_TO = 'michael.henry.miller@remote-advisor.com';\nconst rows = $input.all().sort((a, b) => Number(b.json.id) - Number(a.json.id)).slice(0, MAX);\nreturn rows.map(i => ({ json: {\n  id: i.json.id,\n  lead_key: i.json.lead_key,\n  original_to: i.json.email,\n  to: TEST_TO,\n  subject: '[PG TEST - synthetic] ' + i.json.draft_subject,\n  body: 'SANDBOX TEST. This would have gone to: ' + i.json.email + '\\n----------\\n\\n' + String(i.json.draft_body).replace('[DRAFT - NOT SENT - requires human approval]', '')\n} }));",
    "language": "javaScript",
    "mode": "runOnceForAllItems"
   },
