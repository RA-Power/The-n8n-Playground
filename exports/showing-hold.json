  {
   "id": "d30c5145-7d42-4ee7-8297-f020e14f93a2",
   "name": "Pick slot to hold",
   "parameters": {
    "jsCode": "const rows = $input.all().map(function (i) { return i.json; });\nconst held = {};\nrows.forEach(function (r) { if (r.status === 'hold_confirmed' && r.held_slot) { held[r.held_slot] = true; } });\nconst out = [];\nrows.forEach(function (r) {\n  if (r.status !== 'approved') { return; }\n  const options = String(r.proposed_slots || '').split(' | ').filter(function (s) { return s; });\n  const pick = options.find(function (s) { return !held[s]; });\n  if (pick) {\n    held[pick] = true;\n    out.push({ json: { request_key: r.request_key, status: 'hold_confirmed', held_slot: pick } });\n  } else {\n    out.push({ json: { request_key: r.request_key, status: 'needs_new_times', held_slot: '' } });\n  }\n});\nreturn out;",
    "language": "javaScript",
    "mode": "runOnceForAllItems"
   },
   "position": [
    448,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
