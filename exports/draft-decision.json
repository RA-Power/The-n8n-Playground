   "name": "Validate",
   "parameters": {
    "jsCode": "const body = $json.body || {};\nconst leadKey = String(body.lead_key == null ? '' : body.lead_key).trim().slice(0, 400);\nconst decision = String(body.decision == null ? '' : body.decision).trim().toLowerCase();\nconst note = String(body.note == null ? '' : body.note).replace(/\\s+/g, ' ').trim().slice(0, 300);\nconst errors = [];\nif (!leadKey) errors.push('lead_key_required');\nif (decision !== 'approve' && decision !== 'reject') errors.push('decision_must_be_approve_or_reject');\nreturn { json: { valid: errors.length === 0, errors: errors, lead_key: leadKey, decision: decision, note: note } };",
    "language": "javaScript",
    "mode": "runOnceForEachItem"
   },
   "position": [
    40,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
