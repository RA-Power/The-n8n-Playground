  {
   "id": "50d3b1dd-f9ef-423e-a869-26a389b181a0",
   "name": "Build draft",
   "parameters": {
    "jsCode": "// Deterministic real estate template. No AI, no sends. Draft only.\nconst first = String($json.name || 'there').split(' ')[0];\nconst text = String($json.message || '').toLowerCase();\nlet kind = 'general';\nif (/\\b(sell|selling|list my|listing my|home value|worth)\\b/.test(text)) { kind = 'seller'; }\nelse if (/\\b(rent|renting|lease|tenant)\\b/.test(text)) { kind = 'renter'; }\nelse if (/\\b(buy|buying|purchase|bedroom|condo|house|home)\\b/.test(text)) { kind = 'buyer'; }\nconst lines = {\n  buyer: 'Thanks for reaching out about finding a home. To point you in the right direction: what area are you looking in, and roughly what timeline do you have in mind?',\n  seller: 'Thanks for reaching out about selling. To start: where is the property, and are you hoping to sell on a particular timeline?',\n  renter: 'Thanks for reaching out about a rental. What area and move-in date are you thinking about?',\n  general: 'Thanks for reaching out. Could you tell me a little more about what you are looking for, and the best way to reach you?'\n};\nconst subject = 'Re: your ' + (kind === 'general' ? 'inquiry' : kind === 'renter' ? 'rental inquiry' : kind === 'seller' ? 'question about selling' : 'home search');\nconst body = 'Hi ' + first + ',\\n\\n' + lines[kind] + '\\n\\nHappy to set up a short call if that is easier.\\n\\n[Your name]\\n\\n[DRAFT - NOT SENT - requires human approval]';\nreturn { json: { lead_key: $json.lead_key, name: $json.name, email: $json.email, draft_subject: subject, draft_body: body, status: 'pending', decided_at: '', decision_note: '' } };",
    "language": "javaScript",
    "mode": "runOnceForEachItem"
   },
   "position": [
    460,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
