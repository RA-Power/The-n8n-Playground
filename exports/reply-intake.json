    {
      "id": "ef554ed3-ac43-4071-8f33-7de853cff41a",
      "name": "Classify",
      "parameters": {
        "jsCode": "const known = {};\n$input.all().forEach(function (i) { if (i.json.email) { known[String(i.json.email).toLowerCase()] = i.json.contact_key; } });\nconst stopRe = /\\b(stop|unsubscribe|opt out|opt-out|remove me|do not contact|dont contact|no more emails|leave me alone)\\b/i;\nreturn $('Get unprocessed inbound').all().map(function (i) {\n  const m = i.json;\n  const email = String(m.from_email || '').toLowerCase();\n  const contactKey = known[email] || '';\n  const isStop = stopRe.test(String(m.message || ''));\n  return { json: { inbound_id: m.id, from_email: email, contact_key: contactKey, known: contactKey !== '', new_status: isStop ? 'opted_out' : 'replied', outcome: contactKey === '' ? 'inbound_unknown_sender' : (isStop ? 'contact_opted_out' : 'contact_replied') } };\n});",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        672,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
